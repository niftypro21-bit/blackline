generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: OWNER | ADMIN | MEMBRE. Un seul OWNER doit exister (cree via /setup).
model User {
  id                  String   @id @default(cuid())
  name                String
  username            String   @unique
  passwordHash        String
  role                String   @default("MEMBRE")
  isActive            Boolean  @default(true)
  canAccessAccounting Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  activityLogs    ActivityLog[]
  groupAccess     GroupMember[]
  channelAccess   ChannelMember[]
  messages        Message[]
  ordersRequested Order[]            @relation("OrderRequestedBy")
  ordersDecided   Order[]            @relation("OrderDecidedBy")
  appointments    Appointment[]
  accountingEntries AccountingEntry[]
}

// Table a une seule ligne (id fixe "singleton"). Le webhook n'est jamais renvoye au navigateur.
model Settings {
  id                 String  @id @default("singleton")
  discordWebhookUrl  String?
  updatedAt          DateTime @updatedAt
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  members      GroupMember[]
  channels     Channel[]
  appointments Appointment[]
}

model GroupMember {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Channel {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  members  ChannelMember[]
  messages Message[]

  @@index([groupId])
}

model ChannelMember {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
}

// Prix/quantites fictifs, uniquement pour le jeu de role.
model CatalogItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int      @default(0)
  quantity    Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([archived])
}

// status: EN_ATTENTE | APPROUVEE | REFUSEE. Le stock n'est deduit qu'a l'approbation.
model Order {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  quantity      Int
  status        String      @default("EN_ATTENTE")
  requestedById String
  requestedBy   User        @relation("OrderRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?       @relation("OrderDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([status])
}

// Visible uniquement par les membres ayant acces au groupe concerne.
model Appointment {
  id            String   @id @default(cuid())
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposedById  String
  proposedBy    User     @relation(fields: [proposedById], references: [id])
  title         String
  description   String?
  scheduledAt   DateTime
  location      String?
  createdAt     DateTime @default(now())

  @@index([groupId, scheduledAt])
}

// type: RECETTE | DEPENSE. Montants fictifs (jeu de role uniquement).
model AccountingEntry {
  id          String   @id @default(cuid())
  type        String
  label       String
  amount      Int
  date        DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  notes       String?
  createdAt   DateTime @default(now())

  @@index([date])
}

// action: CREATE | UPDATE | DELETE | ARCHIVE | RESTORE
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  field      String?
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
